					]
				}
			},
			"response": []
		},
		{
			"name": "List Branches",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/branch/{{git-repo-directory}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"branch",
						"{{git-repo-directory}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "List Commits",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/commits/{{git-repo-directory}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"commits",
						"{{git-repo-directory}}"
					]
				}
			},
			"response": []
		},
		{
			"name": "Add File",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"file\": \"test.txt\",\n  \"dir\": \"{{git-repo-directory}}\",\n  \"content\": \"Hello Git!\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/add",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"add"
					]
				}
			},
			"response": []
		},
		{
			"name": "Commit Changes",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"message\": \"Initial commit\",\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"dir\": \"{{git-repo-directory}}\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/commit",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"commit"
					]
				}
			},
			"response": []
		},
		{
			"name": "Get File Content",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/content/main/{{git-repo-directory}}/dGVzdC50eHQ=",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"content",
						"main",
						"{{git-repo-directory}}",
						"dGVzdC50eHQ="
					]
				}
			},
			"response": []
