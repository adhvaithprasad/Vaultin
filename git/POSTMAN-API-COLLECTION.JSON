	"item": [
		{
			"name": "Clone Repository",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"url\": \"{{git-repo-url}}\",\n  \"dir\": \"{{git-repo-directory}}\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/clone",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"clone"
					]
				}
			},
			"response": []
		},
		{
			"name": "List Repositories",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/list-repos",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"list-repos"
					]
				}
			},
			"response": []
		},
		{
			"name": "List Files in Repo",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/files/{{git-repo-directory}}",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
